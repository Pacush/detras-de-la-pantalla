; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Detras de la pantalla"
run/main_scene="uid://dws3eu0441iod"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"alien": "res://dialogic/characters/alien.dch",
"mc": "res://dialogic/characters/mc.dch",
"natsuri": "res://dialogic/characters/natsuri.dch"
}
directories/dtl_directory={
"timeline": "res://dialogic/timeline.dtl"
}
layout/style_directory={
"": "res://dialogic/styles/style1.tres",
"style1": "res://dialogic/styles/style1.tres"
}
layout/style_list=["res://dialogic/styles/style1.tres"]
layout/default_style="res://dialogic/styles/style1.tres"
glossary/default_case_sensitive=true
glossary/glossary_files=["uid://di540tlp4h5if"]

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

